pipeline {
    agent any
    stages {
        stage('Clean Old Container') {
            steps {
                bat 'docker rm -f dev-app || exit 0'
            }
        }
        stage('Build') {
            steps {
                withCredentials([string(credentialsId: 'SUPABASE_URL', variable: 'URL'), 
                                 string(credentialsId: 'SUPABASE_KEY', variable: 'KEY')]) {
                    bat """
                docker build --no-cache --build-arg VITE_SUPABASE_URL="%URL%" --build-arg VITE_SUPABASE_ANON_KEY="%KEY%" -t app-dev .
            """
                }
                // DELETE THIS LINE: bat 'docker build -t app-dev .'  <-- This was re-building it empty!
            }
        }
        stage('Run') {
            steps {
                bat 'docker run -d -p 8083:80 --name dev-app app-dev'
            }
        }
        stage('Test') {
            steps {
                bat 'smoke_test.bat'
            }
        }
    }
}