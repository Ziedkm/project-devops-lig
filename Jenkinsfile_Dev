pipeline {
    agent any
    stages {
        stage('Build') { steps { sh 'docker build -t app-dev .' } }
        stage('Run') { steps { sh 'docker run -d -p 8083:80 --name dev-app app-dev' } }
        stage('Test') { steps { sh 'bash ./smoke_test.sh' } }
    }
    post { always { sh 'docker rm -f dev-app' } }
}
