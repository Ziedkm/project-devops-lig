pipeline {
    agent any

    stages {

        stage('Clean Old Container') {
            steps {
                bat 'docker rm -f dev-app || exit 0'
            }
        }

        stage('Build') {
            steps {
                withCredentials([
                    string(credentialsId: 'SUPABASE_URL', variable: 'SUPA_URL'),
                    string(credentialsId: 'SUPABASE_KEY', variable: 'SUPA_KEY')
                ]) {

                    // Create .env.production for Vite
                    bat """
                    echo VITE_SUPABASE_URL=%SUPA_URL% > .env.production
                    echo VITE_SUPABASE_ANON_KEY=%SUPA_KEY% >> .env.production
                    """

                    // Build Docker image
                    bat """
                    docker build --no-cache -t app-dev .
                    """
                }
            }
        }

        stage('Run') {
            steps {
                bat 'docker run -d -p 8083:80 --name dev-app app-dev'
            }
        }

        stage('Test') {
            steps {
                bat 'smoke_test.bat'
            }
        }
    }
}
