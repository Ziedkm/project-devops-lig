pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build') {
            steps {
                withCredentials([
                    string(credentialsId: 'SUPABASE_URL', variable: 'SUPA_URL'),
                    string(credentialsId: 'SUPABASE_KEY', variable: 'SUPA_KEY'),
                    string(credentialsId: 'SUPABASE_SERVICE_KEY', variable: 'SUPA_SERVICE_KEY')
                ]) {
                    powershell """
                Set-Content -Path .env -Value "VITE_SUPABASE_URL=${SUPA_URL}" -Encoding ASCII
                Add-Content -Path .env -Value "VITE_SUPABASE_ANON_KEY=${SUPA_KEY}" -Encoding ASCII
                Add-Content -Path .env -Value "VITE_SUPABASE_SERVICE_KEY=${SUPA_SERVICE_KEY}" -Encoding ASCII
            """
                    bat 'docker build --no-cache -t app-pr .'
                }
            }
        }

        stage('Run') {
            steps {
                bat 'docker run -d -p 8083:80 --name pr-app app-pr'
            }
        }

        stage('Test') {
            steps {
                bat 'smoke_test.bat 8083'
            }
        }

        stage('Cleanup') {
            steps {
                bat 'docker rm -f pr-app || exit /b 0'
            }
        }
    }
}
