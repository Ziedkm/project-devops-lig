pipeline {
    agent any
    stages {
        stage('Build') { steps { sh 'docker build -t app-pr .' } }
        stage('Run') { steps { sh 'docker run -d -p 8081:80 --name pr-app app-pr' } }
        stage('Test') { steps { sh 'bash ./smoke_test.sh' } }
    }
    post { always { sh 'docker rm -f pr-app' } }
}
