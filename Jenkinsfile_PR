pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                withCredentials([
                    string(credentialsId: 'SUPABASE_URL', variable: 'SUPA_URL'),
                    string(credentialsId: 'SUPABASE_KEY', variable: 'SUPA_KEY')
                ]) {

                    // Create .env.production
                    bat """
                    echo VITE_SUPABASE_URL=%SUPA_URL% > .env.production
                    echo VITE_SUPABASE_ANON_KEY=%SUPA_KEY% >> .env.production
                    """

                    // Build PR image
                    bat """
                    docker build --no-cache -t app-pr .
                    """
                }
            }
        }

        stage('Run') {
            steps {
                bat 'docker run -d -p 8082:80 --name pr-app app-pr'
            }
        }

        stage('Test') {
            steps {
                bat 'smoke_test.bat'
            }
        }
    }

    post {
        always {
            bat 'docker rm -f pr-app'
        }
    }
}
