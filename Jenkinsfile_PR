pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                withCredentials([string(credentialsId: 'SUPABASE_URL', variable: 'SUPA_URL'), 
                                 string(credentialsId: 'SUPABASE_KEY', variable: 'SUPA_KEY')]) {
                    
                    // Create .env file
                    powershell """
                        Set-Content -Path .env -Value "VITE_SUPABASE_URL=${SUPA_URL}"
                        Add-Content -Path .env -Value "VITE_SUPABASE_ANON_KEY=${SUPA_KEY}"
                    """
                    
                    docker build --no-cache -t app-pr ^
                    --build-arg VITE_SUPABASE_URL=%SUPA_URL% ^
                    --build-arg VITE_SUPABASE_ANON_KEY=%SUPA_KEY% .

                }
            }
        }
        stage('Run') {
            steps {
                bat 'docker run -d -p 8082:80 --name pr-app app-pr'
            }
        }
        stage('Test') {
            steps {
                bat 'smoke_test.bat'
            }
        }
    }
    post {
        always {
            bat 'docker rm -f pr-app'
        }
    }
}