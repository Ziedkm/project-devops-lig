pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                withCredentials([string(credentialsId: 'SUPABASE_URL', variable: 'SUPA_URL'), 
                                 string(credentialsId: 'SUPABASE_KEY', variable: 'SUPA_KEY')]) {
                    // ONLY run this ONE command.
                    bat """
                docker build --no-cache --build-arg VITE_SUPABASE_URL="${SUPA_URL}" --build-arg VITE_SUPABASE_ANON_KEY="${SUPA_KEY}" -t app-pr .
            """
                }
                // DELETE THIS LINE: bat 'docker build -t app-pr .' <-- This was overwriting your good build!
            }
        }
        stage('Run') {
            steps {
                bat 'docker run -d -p 8082:80 --name pr-app app-pr'
            }
        }
        stage('Test') {
            steps {
                bat 'smoke_test.bat'
            }
        }
    }
    post {
        always {
            bat 'docker rm -f pr-app'
        }
    }
}